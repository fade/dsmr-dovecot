# Passdb and userdb for vpopmail MySQL backend.
# Connection details are in /etc/dovecot/dovecot-vpopmail-sql.conf.ext,
# which is generated by the postinst script from /home/vpopmail/etc/vpopmail.mysql.

passdb {
  driver = sql
  args = /etc/dovecot/dovecot-vpopmail-sql.conf.ext
}

userdb {
  driver = sql
  args = /etc/dovecot/dovecot-vpopmail-sql.conf.ext
}
