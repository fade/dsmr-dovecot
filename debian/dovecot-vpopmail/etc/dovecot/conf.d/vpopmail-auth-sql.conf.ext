# MySQL connection and passdb/userdb for vpopmail authentication.
# The connection block is in /etc/dovecot/dovecot-vpopmail-sql.conf.ext,
# generated by postinst from /home/vpopmail/etc/vpopmail.mysql.
!include_try /etc/dovecot/dovecot-vpopmail-sql.conf.ext

passdb sql {
  query = \
    SELECT pw_passwd AS password, pw_dir AS userdb_home, \
           89 AS userdb_uid, 89 AS userdb_gid \
    FROM vpopmail \
    WHERE pw_name = '%{user|username}' AND pw_domain = '%{user|domain}'
}

userdb sql {
  query = \
    SELECT pw_dir AS home, 89 AS uid, 89 AS gid \
    FROM vpopmail \
    WHERE pw_name = '%{user|username}' AND pw_domain = '%{user|domain}'
  iterate_query = \
    SELECT CONCAT(pw_name, '@', pw_domain) AS user FROM vpopmail
}
