#!/bin/sh
set -e

VPOPMAIL_PGSQL=/home/vpopmail/etc/vpopmail.pgsql
DOVECOT_SQL=/etc/dovecot/dovecot-vpopmail-sql.conf.ext
DOVECOT_CERT=/etc/dovecot/private/dovecot.pem
DOVECOT_KEY=/etc/dovecot/private/dovecot.key
QMAIL_CERT=/etc/qmail/servercert.pem

generate_sql_conf() {
    # Parse vpopmail.pgsql: host|port|database|user|password
    if [ ! -f "$VPOPMAIL_PGSQL" ]; then
        echo "dovecot-vpopmail: $VPOPMAIL_PGSQL not found; skipping SQL config generation" >&2
        return 1
    fi

    # vpopmail.pgsql format: host|port|user|password|database
    line=$(cat "$VPOPMAIL_PGSQL")
    db_host=$(echo "$line" | cut -d'|' -f1)
    db_port=$(echo "$line" | cut -d'|' -f2)
    db_user=$(echo "$line" | cut -d'|' -f3)
    db_pass=$(echo "$line" | cut -d'|' -f4)
    db_name=$(echo "$line" | cut -d'|' -f5)

    if [ -z "$db_host" ] || [ -z "$db_user" ] || [ -z "$db_pass" ] || [ -z "$db_name" ]; then
        echo "dovecot-vpopmail: could not parse $VPOPMAIL_PGSQL" >&2
        return 1
    fi

    # Dovecot 2.4 pgsql driver format: host is the section label; credentials
    # go inside a 'parameters { }' sub-block (libpq keyword/value settings).
    # Port 5432 is the default; only include it when non-standard.
    if [ "$db_port" = "5432" ] || [ -z "$db_port" ] || [ "$db_port" = "0" ]; then
        port_line=""
    else
        port_line="    port = ${db_port}"
    fi

    {
        echo "# PostgreSQL connection for vpopmail authentication (generated by postinst)."
        echo "sql_driver = pgsql"
        echo "pgsql ${db_host} {"
        echo "  parameters {"
        echo "    dbname = ${db_name}"
        echo "    user = ${db_user}"
        echo "    password = ${db_pass}"
        [ -n "$port_line" ] && echo "$port_line"
        echo "  }"
        echo "}"
    } > "$DOVECOT_SQL"
    chmod 640 "$DOVECOT_SQL"
    chown root:dovecot "$DOVECOT_SQL"
}

setup_tls() {
    # Do nothing if dovecot already has a cert.
    [ -f "$DOVECOT_CERT" ] && return 0

    mkdir -p /etc/dovecot/private
    chmod 750 /etc/dovecot/private

    if [ -f "$QMAIL_CERT" ]; then
        # Extract cert and key from the qmail combined PEM.
        openssl x509 -in "$QMAIL_CERT" -out "$DOVECOT_CERT" 2>/dev/null
        openssl pkey -in "$QMAIL_CERT" -out "$DOVECOT_KEY" 2>/dev/null
    else
        # Fall back to a self-signed certificate.
        openssl req -new -x509 -days 3650 -nodes \
            -out "$DOVECOT_CERT" -keyout "$DOVECOT_KEY" \
            -subj "/CN=$(hostname -f 2>/dev/null || echo localhost)" 2>/dev/null
    fi

    if [ -f "$DOVECOT_CERT" ] && [ -f "$DOVECOT_KEY" ]; then
        chown root:dovecot "$DOVECOT_CERT" "$DOVECOT_KEY"
        chmod 644 "$DOVECOT_CERT"
        chmod 600 "$DOVECOT_KEY"
    fi
}

case "$1" in
    configure)
        generate_sql_conf || true
        setup_tls || true

        # Create the system-passwd file if it does not exist.
        # This file holds passwd(5)-format entries for local Unix users that
        # should be accessible via IMAP using user@defaultdomain addressing.
        if [ ! -f /etc/dovecot/system-passwd ]; then
            touch /etc/dovecot/system-passwd
            chown root:dovecot /etc/dovecot/system-passwd
            chmod 640 /etc/dovecot/system-passwd
        fi

        if command -v doveadm >/dev/null 2>&1; then
            doveadm reload 2>/dev/null || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#
exit 0
